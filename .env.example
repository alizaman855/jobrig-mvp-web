# Postgres connection string (Neon, Supabase, or local).
DATABASE_URL="postgresql://user:password@localhost:5432/jobrig?schema=public"

# NextAuth.js (Auth.js) signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Vercel Blob — Storage tab in the Vercel dashboard > create a Blob store > .env.local tab
BLOB_READ_WRITE_TOKEN=""

# Resend — resend.com/api-keys. Using the shared onboarding@resend.dev sender
# for now (no verified domain); swap RESEND_FROM once a domain is verified.
RESEND_API_KEY=""
